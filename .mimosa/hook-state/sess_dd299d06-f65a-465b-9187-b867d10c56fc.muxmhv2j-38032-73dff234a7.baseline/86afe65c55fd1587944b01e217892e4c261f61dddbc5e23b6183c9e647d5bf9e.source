import service from '@/utils/request'

export const createAlertRule = (data) => service({ url: '/monitor/alert/rule', method: 'post', data })
export const updateAlertRule = (data) => service({ url: '/monitor/alert/rule', method: 'put', data })
export const deleteAlertRule = (params) => service({ url: '/monitor/alert/rule', method: 'delete', params })
export const getAlertRules = () => service({ url: '/monitor/alert/rule/list', method: 'get' })
export const getAlertEvents = (data) => service({ url: '/monitor/alert/event/list', method: 'post', data })
