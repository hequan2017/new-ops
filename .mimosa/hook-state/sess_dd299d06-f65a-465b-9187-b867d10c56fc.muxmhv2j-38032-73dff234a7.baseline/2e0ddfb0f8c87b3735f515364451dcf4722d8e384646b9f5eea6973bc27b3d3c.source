import service from '@/utils/request'

export const getTermSessionList = (data) => {
  return service({ url: '/term/session/list', method: 'post', data })
}
export const getTermSessionStreams = (params) => {
  return service({ url: '/term/session/streams', method: 'get', params })
}
export const getTermSessionCommands = (params) => {
  return service({ url: '/term/session/commands', method: 'get', params })
}
