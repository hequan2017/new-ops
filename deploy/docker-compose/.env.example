# 白泽 docker-compose 本地联调环境变量（复制为 .env 后按需修改；不创建 .env 时使用默认值，行为与历史版本一致）

# 前端入口端口（nginx 容器映射）
WEB_PORT=8080
# 后端 API 端口
API_PORT=8888
# MySQL 对宿主机暴露端口（容器内 3306）
MYSQL_PORT=13306
# Redis 对宿主机暴露端口
REDIS_PORT=16379

# MySQL 应用账号密码（生产/长期运行环境务必修改默认值）
MYSQL_PASSWORD=Aa@6447985
# 初始化数据库名（server config 需与之对应）
MYSQL_DATABASE=qmPlus

# 凭据保险库主密钥（AES-256-GCM 信封加密，注入 server 容器环境变量；留空则凭据功能不可用）
# 生成示例：openssl rand -base64 32
CREDENTIAL_MASTER_KEY=
