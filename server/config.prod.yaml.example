# 白泽 生产环境配置样例（config.prod.yaml.example）
#
# 用法：复制为 config.yaml 后按实际环境修改。部署脚本不会覆盖远端已有 config.yaml。
# 与开发默认配置（config.yaml）的差异项如下，未列出的项保持一致。
#
# 安全红线：
#   1. jwt.signing-key 必须更换为高强度随机值，并通过环境变量/密钥管理注入
#   2. 数据库密码、云 AK 等凭据一律走 asset 凭据保险库（AES-256-GCM），不写入本文件
#   3. captcha.open-captcha 生产环境必须恢复为 0（登录验证码常开）

system:
    env: public                     # 关闭路由日志输出
    addr: 8888
    db-type: mysql                  # 生产使用 MySQL（测试环境为 sqlite）
    use-redis: true                 # 生产开启 Redis（多点登录限制/缓存）

captcha:
    open-captcha: 0                 # 0 代表验证码常开（生产必须）

jwt:
    signing-key: 请替换为高强度随机值  # 例: openssl rand -base64 32

mysql:
    path: 127.0.0.1
    port: "3306"
    config: charset=utf8mb4&parseTime=True&loc=Local
    db-name: new_ops
    username: new_ops
    password: ""                    # 从凭据保险库/环境变量注入，勿提交明文

# M1 起启用的凭据保险库主密钥（数据密钥用主密钥信封加密）
# 通过环境变量注入: export NEW_OPS_CREDENTIAL_MASTER_KEY=...
# credential:
#     master-key-env: NEW_OPS_CREDENTIAL_MASTER_KEY
